<?xml version="1.0" encoding="utf-8"?>
<!-- Discover plays YouTube audio through just_audio's small server on the
     phone itself (http://127.0.0.1), which Android blocks unless plain HTTP
     is allowed for it. Only the phone's own address is allowed; everything
     else stays HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
